# Copier ce fichier en ".env" (jamais versionné), puis remplir les valeurs.

# --- Pack de domaine chargé par défaut ---
DOMAIN=imagerie_medicale
# Dossier des packs (par défaut : domains/ à la racine du dépôt)
# DOMAINS_DIR=

# --- ElevenLabs : synthèse vocale (et STT facultatif) ---
ELEVENLABS_API_KEY=
# Vide = première voix disponible sur le compte
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 (rapide, moitié prix) | eleven_multilingual_v2 (qualité)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- LLM : n'importe quelle API compatible OpenAI (Chat Completions) ---
# Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Groq   : LLM_BASE_URL=https://api.groq.com/openai/v1
# Ollama : LLM_BASE_URL=http://localhost:11434/v1   (LLM_API_KEY=ollama)
# Vide = pas de LLM : l'agent fonctionne avec les règles seules.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# json_schema (défaut) | json_object (si le fournisseur ne gère pas json_schema)
LLM_JSON_MODE=json_schema
# Plafonds de budget pour un processus (0 = pas de plafond)
LLM_MAX_CALLS=0
LLM_MAX_TOKENS=0
